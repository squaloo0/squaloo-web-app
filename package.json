{
  "name": "squaloo-web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "ts-node --project tsconfig.scripts.json src/app/marshal-qr/db/seed.ts",
    "remora": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON workers/remora/cli.ts",
    "remora:worker": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON workers/remora/worker.ts",
    "remora:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/remora/**/*.test.ts\"",
    "remora:install": "sh workers/remora/launchd/remora-launchd.sh install",
    "remora:uninstall": "sh workers/remora/launchd/remora-launchd.sh uninstall",
    "remora:status": "sh workers/remora/launchd/remora-launchd.sh status",
    "garage": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON workers/garage/cli.ts",
    "garage:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/garage/**/*.test.ts\" \"workers/garage/*.test.ts\"",
    "garage:install": "sh workers/garage/launchd/garage-launchd.sh install",
    "garage:uninstall": "sh workers/garage/launchd/garage-launchd.sh uninstall",
    "garage:status": "sh workers/garage/launchd/garage-launchd.sh status"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@neondatabase/serverless": "^0.10.4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/animejs": "^3.1.13",
    "@types/prismjs": "^1.26.5",
    "@types/qrcode": "^1.5.5",
    "animejs": "^4.1.2",
    "drizzle-orm": "^0.40.0",
    "marked": "^18.0.12",
    "next": "^15.3.6",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9",
    "eslint-config-next": "^15.3.6",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
